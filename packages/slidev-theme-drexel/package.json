{
  "name": "slidev-theme-drexel",
  "version": "1.0.0",
  "private": true,
  "description": "Drexel blue and gold, minus the letterhead. Theme for CS lecture decks.",
  "keywords": [
    "slidev-theme"
  ],
  "engines": {
    "slidev": ">=52.0.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "transition": "fade",
      "routerMode": "hash",
      "drawings": {
        "persist": "annotations/live"
      },
      "fonts": {
        "sans": "Source Sans 3",
        "serif": "Bricolage Grotesque Variable",
        "mono": "JetBrains Mono",
        "provider": "none"
      }
    }
  }
}